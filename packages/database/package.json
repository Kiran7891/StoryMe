{
  "name": "@storyme/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "migrations"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@storyme/shared-types": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@storyme/eslint-config": "workspace:*",
    "@storyme/typescript-config": "workspace:*",
    "@types/node": "^20.16.10",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.11.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}

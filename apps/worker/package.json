{
  "name": "@storyme/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --clean --sourcemap",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.667.0",
    "@storyme/ai": "workspace:*",
    "@storyme/config": "workspace:*",
    "@storyme/database": "workspace:*",
    "@storyme/shared-types": "workspace:*",
    "bullmq": "^5.21.2",
    "drizzle-orm": "^0.36.4",
    "nanoid": "^5.0.7",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@storyme/eslint-config": "workspace:*",
    "@storyme/typescript-config": "workspace:*",
    "@types/node": "^20.16.10",
    "eslint": "^9.11.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}

# ---------------------------------------------------------------------------
# StoryMe environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# Server-only secrets live here; client-exposed values must be prefixed per app
# (NEXT_PUBLIC_* for web, EXPO_PUBLIC_* for mobile).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Database (Supabase / Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/storyme
DATABASE_POOL_URL=

# Redis (BullMQ queue) — local docker or Upstash
REDIS_URL=redis://localhost:6379

# Auth (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# Object storage (Cloudflare R2)
STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_BUCKET=storyme-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=https://cdn.storyme.app

# AI providers (server-only) — default to `mock` for local dev
AI_TEXT_PROVIDER=mock
AI_IMAGE_PROVIDER=mock
AI_TEXT_API_KEY=
AI_IMAGE_API_KEY=
AI_DAILY_SPEND_CAP_USD=100

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_SECRET=

# Integrations
RESEND_API_KEY=
SENTRY_DSN=
POSTHOG_API_KEY=

# Security
RATE_LIMIT_MAX=120
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# --- Client-exposed (web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Client-exposed (mobile) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
